<section class="table-section">
    <article>

        <!-- validating data the success message -->
        <!-- <% if(success){ %>
        <div class="alert alert-success" role="alert">
            Validation Successful
        </div>
        <% } %> -->

        <% if(locals.lastVisit){ %>
            <div class="alert alert-primary" role="alert">
                Last Visit: <%= locals.lastVisit %>
            </div>
            <% } %>

                <!-- Table for the content -->
                <div class="counting">

                </div>
                <h1 class="mt-5 mb-4 header" style="color: aliceblue;">Products:</h1>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Image</th>
                                <th>Rating</th>
                                <th>Count</th>
                                <th colspan="4" style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>

                            <!-- view engine -->
                            <% products.forEach((product)=> { %>
                                <tr>
                                    <td>
                                        <%= product.id %>
                                    </td>
                                    <td>
                                        <%= product.title %>
                                    </td>
                                    <td>
                                        <%= product.price %>
                                    </td>
                                    <td>
                                        <%= product.description %>
                                    </td>
                                    <td>
                                        <%= product.category %>
                                    </td>
                                    <td>
                                        <img src="<%= product.image %>" alt="<%= product.title %>">
                                    </td>
                                    <td>
                                        <%= product.rating %>
                                    </td>
                                    <td>
                                        <%= product.count %>
                                    </td>
                                    <td>
                                        <!-- passing the parameter to the url -->
                                        <a href="/update-product/<%= product.id %>">
                                            <button>
                                                Update
                                            </button>
                                        </a>

                                        <!-- <a href="/delete-product/<%= product.id %>" class="btn btn-danger">Delete</a> -->
                                        <button onclick="deleteProduct('<%= product.id %>')">Delete</button>

                                    </td>
                                </tr>
                                <% }) %>

                        </tbody>
                    </table>
                </div>
    </article>
</section>